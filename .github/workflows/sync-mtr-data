name: Sync official MTR fare data

on:
  workflow_dispatch:
  push:
    branches: [ main ]
  schedule:
    - cron: '25 3 2 * *'

permissions:
  contents: write

jobs:
  sync:
    if: github.actor != 'github-actions[bot]'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Download official MTR CSV files
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p data
          curl -fL --retry 4 --retry-delay 2 \
            'https://opendata.mtr.com.hk/data/mtr_lines_fares.csv' \
            -o data/mtr_lines_fares.csv
          curl -fL --retry 4 --retry-delay 2 \
            'https://opendata.mtr.com.hk/data/airport_express_fares.csv' \
            -o data/airport_express_fares.csv
          curl -fL --retry 4 --retry-delay 2 \
            'https://opendata.mtr.com.hk/data/light_rail_routes_and_stops.csv' \
            -o data/light_rail_routes_and_stops.csv
          curl -fL --retry 4 --retry-delay 2 \
            'https://opendata.mtr.com.hk/data/light_rail_fares.csv' \
            -o data/light_rail_fares.csv

          test "$(wc -c < data/mtr_lines_fares.csv)" -gt 10000
          test "$(wc -c < data/airport_express_fares.csv)" -gt 100
          test "$(wc -c < data/light_rail_routes_and_stops.csv)" -gt 100
          test "$(wc -c < data/light_rail_fares.csv)" -gt 100
          date -u +'%Y-%m-%dT%H:%M:%SZ' > data/last-updated.txt

      - name: Commit only when official data changed
        shell: bash
        run: |
          set -euo pipefail
          if git diff --quiet -- data/ && [ -z "$(git ls-files --others --exclude-standard data/)" ]; then
            echo 'No fare-data change.'
            exit 0
          fi
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add data/
          git commit -m 'chore: refresh official MTR fare data [skip ci]'
          git push
